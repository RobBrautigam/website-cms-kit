# Website CMS Kit - environment variables
# Copy to .env.local for development; set these in your host dashboard for prod.
# NEVER commit real values. Only NEXT_PUBLIC_* vars are exposed to the browser.

# --- Supabase (required) ---
# Project URL + anon key are public by design (the anon key ships in the client
# bundle; Row-Level Security protects the data). A newer publishable key
# (sb_publishable_...) works in the same variable, and a secret key
# (sb_secret_...) works in SUPABASE_SERVICE_ROLE_KEY below.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service-role key - SERVER ONLY. Bypasses RLS (admin god mode). Used by the
# admin API routes, the audit writer, requireAdmin()'s role lookup, the AI
# rate limit and the redirect counter.
# NEVER expose this to the browser or the CI build environment.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Optional ---
# Only needed if you use the /api/ai/* content-generation routes.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# --- The public site (see docs/14) ---
# The public origin: every canonical, share image, schema id, sitemap entry and
# the editor's search and share previews are built from it. REQUIRED in
# production (a production build refuses a missing or localhost value);
# development falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# The brand name in titles and schema (default Acme), and one sentence about
# the site for llms.txt and the WebSite schema.
NEXT_PUBLIC_SITE_NAME=Acme
NEXT_PUBLIC_SITE_DESCRIPTION=What the site is about, in one sentence.
# 1 keeps the whole deployment out of search engines (robots disallow, noindex,
# empty sitemap). Staging and preview deployments only; never in production.
# NEXT_PUBLIC_NOINDEX=1

# Content Security Policy (see docs/11). Defaults: report only, /admin only.
# CSP_MODE=enforce
# CSP_SCOPE=site
# CSP_REPORT_URI=https://your-domain.com/csp-reports

# HSTS (see docs/09). Default: max-age only. 1 adds includeSubDomains; preload.
# HSTS_PRELOAD=1

# Proxies in front of the app that append to X-Forwarded-For (default 1).
# The rate limits read the caller that many entries from the right.
# TRUSTED_PROXY_HOPS=2

# Scheduled posts' images (see docs/13). Default: public when the post is
# scheduled. at_publish keeps them private until the post's date; then the
# scheduler must call POST /api/cron/scheduled-publishing every minute with
# "Authorization: Bearer <CRON_SECRET>" (at least 32 characters, server only).
# SCHEDULED_IMAGES=at_publish
# CRON_SECRET=YOUR_LONG_RANDOM_SECRET
